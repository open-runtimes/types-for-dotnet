<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetRuntime</RootNamespace>

    <PackageId>OpenRuntimes.Types</PackageId>
    <Version>0.0.1</Version>
    <Authors>Open Runtimes</Authors>
    <Description>Types for .NET Open Runtime</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/open-runtimes/types-for-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/open-runtimes/types-for-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>open-runtimes;serverless;functions</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
